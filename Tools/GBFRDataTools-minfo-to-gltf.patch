     /// <summary>
+    /// PATCH: finds the [min, max] vertex index used by each chunk of a lod.
+    /// </summary>
+    private List<(int Min, int Max)> ScanChunkRanges(StreamLOD lod, string meshName)
+    {
+        string lodMeshPath = Path.Combine(_extractedDir, "model_streaming", meshName, $"{_modelName}.mmesh");
+        using FileStream lodMeshStream = File.Open(lodMeshPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+        using BinaryStream lodMeshBinaryStream = new BinaryStream(lodMeshStream);
+
+        var ranges = new List<(int Min, int Max)>(lod.Chunks.Count);
+        foreach (LODChunk chunk in lod.Chunks)
+        {
+            lodMeshBinaryStream.Position = (int)lod.Buffers[^1].Offset + chunk.Offset * sizeof(int); // Last is indices
+            int min = int.MaxValue, max = int.MinValue;
+            for (int i = 0; i < chunk.Count; i++)
+            {
+                int index = lodMeshBinaryStream.ReadInt32();
+                min = Math.Min(min, index);
+                max = Math.Max(max, index);
+            }
+
+            if (chunk.Count == 0)
+                (min, max) = (0, -1);
+
+            ranges.Add((min, max));
+        }
+
+        return ranges;
+    }
+
+    /// <summary>
+    /// PATCH: exact glTF buffer size needed for one lod entity, as written by HandleLODEntity.
+    /// </summary>
+    private int CalculateLODEntityBufferSize(StreamLOD lod, string meshName)
+    {
+        int numVerts = 0, numIndices = 0;
+        var ranges = ScanChunkRanges(lod, meshName);
+        for (int i = 0; i < ranges.Count; i++)
+        {
+            numVerts += ranges[i].Max - ranges[i].Min + 1;
+            numIndices += lod.Chunks[i].Count;
+        }
+
+        int perVertex = 0;
+        for (int type = 0; type <= 6; type++)
+        {
+            VertexBufferType checkType = (VertexBufferType)(1 << type);
+            if (!lod.BufferTypes.HasFlag(checkType))
+                continue;
+
+            perVertex += checkType switch
+            {
+                VertexBufferType.POS_NOR_TAN_UV0 => 0x30,
+                VertexBufferType.COLOR => 0x04,
+                _ => 0x08, // blend indices/weights
+            };
+        }
+
+        return (numVerts * perVertex) + (numIndices * sizeof(int));
+    }
